#  Copia este archivo como .env y rellena los valores 
# cp .env.template .env

# Flask
 COBRANZA_FLASK_ENV=development
 COBRANZA_FLASK_DEBUG=1

# Base de datos PostgreSQL
 COBRANZA_DATABASE_HOST=localhost
 COBRANZA_DATABASE_USER=tu_usuario
 COBRANZA_DATABASE_PASS=tu_password
 COBRANZA_DATABASE_DB=Empresas
 COBRANZA_DATABASE_PORT=5432

# Seguridad
 COBRANZA_SECRET_KEY=cambia_esto_por_un_string_aleatorio_seguro
 COBRANZA_JWT_SECRET_KEY=otro_string_aleatorio_para_jwt

# Imágenes
UPLOAD_FOLDER = 'aa'
 COBRANZA_MAX_CONTENT_LENGTH=5242880

# Logs
 COBRANZA_LOG_FILE_ROUTE=logs/
